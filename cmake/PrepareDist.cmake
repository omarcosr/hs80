set(dest "${HS80_ROOT}/dist")
if(NOT EXISTS "${dest}/hs80.ini")
 configure_file("${HS80_ROOT}/defaults/hs80.ini" "${dest}/hs80.ini" COPYONLY)
endif()
configure_file("${HS80_ROOT}/LEIA-ME.txt" "${dest}/LEIA-ME.txt" COPYONLY)
configure_file("${HS80_ROOT}/vendor/CUI/LICENSE" "${dest}/licencas/CUI-LICENSE.txt" COPYONLY)
configure_file("${HS80_ROOT}/vendor/CUI/THIRD_PARTY.md" "${dest}/licencas/THIRD_PARTY.md" COPYONLY)
foreach(font Inter Geist Lucide)
 configure_file("${HS80_ROOT}/vendor/CUI/assets/fonts/LICENSE-${font}.txt" "${dest}/licencas/LICENSE-${font}.txt" COPYONLY)
endforeach()
